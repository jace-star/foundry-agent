# FastAPI 监听地址与端口
APP_HOST=0.0.0.0
APP_PORT=9110

# 对象存储类型
OPENDAL_STORAGE_TYPE=s3
# 本地文件系统存储根目录，OPENDAL_STORAGE_TYPE=fs 时使用
OPENDAL_FS_ROOT=data
# S3 Bucket 名称
OPENDAL_S3_BUCKET=your-bucket
# S3 服务地址
OPENDAL_S3_ENDPOINT=http://localhost:9003
# S3 区域
OPENDAL_S3_REGION=us-east-1
# S3 Access Key ID
AWS_ACCESS_KEY_ID=your-access-key-id
# S3 Secret Access Key
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# OpenAI-compatible 模型服务地址
OPENAI_BASE_URL=https://api.openai.com/v1
# OpenAI-compatible 模型名称
OPENAI_MODEL=gpt-4o-mini
# OpenAI-compatible API Key
OPENAI_API_KEY=sk-your-api-key
# 最大输出 token 数；不填则使用模型默认
# OPENAI_MAX_TOKENS=4096
# 模型请求超时时间，单位秒
OPENAI_TIMEOUT_SECONDS=60

# Langfuse 追踪 — 留空则自动禁用，零开销
# LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxx
# LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxxx
# LANGFUSE_HOST=http://localhost:3000

# Redis 缓存/会话存储
REDIS_PORT=6379

# 数据库（PostgreSQL / MySQL）
DB_DRIVER=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_USER=agent
DB_PASSWORD=agent
DB_NAME=agent
# 也可直接用完整 URL（优先于上方字段）
# DATABASE_URL=postgresql://agent:agent@localhost:5432/agent
# DATABASE_URL=mysql://agent:agent@localhost:3306/agent

# 系统管理员账号 — 启动时自动创建，留空则跳过
# ADMIN_ACCOUNT=admin
# ADMIN_PASSWORD=change-me-in-production
